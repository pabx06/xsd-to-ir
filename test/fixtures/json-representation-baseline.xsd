<?xml version="1.0" encoding="UTF-8"?>
<!-- A small schema for scalar/shape cases that are hard to isolate in S3000L. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="lsaDataset">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="msgId" type="xs:string"/>
        <xs:element name="msgDate" type="xs:date"/>
        <xs:element name="msgType">
          <xs:complexType><xs:sequence><xs:element name="code" type="xs:string"/></xs:sequence></xs:complexType>
        </xs:element>
        <xs:element name="logisticsSupportAnalysisData" type="logisticsSupportAnalysisMessageContent"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
  <xs:complexType name="logisticsSupportAnalysisMessageContent">
    <xs:sequence>
      <xs:element name="lsaPrimaryData">
        <xs:complexType><xs:sequence>
          <xs:element name="products">
            <xs:complexType><xs:sequence>
              <xs:element name="prod" type="product" maxOccurs="unbounded"/>
            </xs:sequence></xs:complexType>
          </xs:element>
        </xs:sequence></xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="product">
    <xs:sequence><xs:element name="payload" type="Payload"/></xs:sequence>
    <xs:attribute name="uid" type="xs:ID" use="required"/>
    <xs:attribute name="crud" type="xs:string" use="required"/>
  </xs:complexType>
  <xs:complexType name="Payload">
    <xs:sequence>
      <xs:element name="text" type="xs:string" minOccurs="0"/>
      <xs:element name="token" type="xs:token" minOccurs="0"/>
      <xs:element name="code" type="Code" minOccurs="0"/>
      <xs:element name="integer" type="xs:integer" minOccurs="0"/>
      <xs:element name="decimal" type="xs:decimal" minOccurs="0"/>
      <xs:element name="flag" type="xs:boolean" minOccurs="0"/>
      <xs:element name="tag" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="item" type="Item" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="optional" type="Item" minOccurs="0" nillable="true"/>
      <xs:element name="note" type="Note" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="code" type="xs:string"/>
    <xs:attribute name="label" type="xs:string"/>
  </xs:complexType>
  <xs:simpleType name="Code">
    <xs:restriction base="xs:string">
      <xs:enumeration value="01"/>
      <xs:enumeration value="true"/>
      <xs:enumeration value="ABC"/>
    </xs:restriction>
  </xs:simpleType>
  <xs:complexType name="Item">
    <xs:sequence><xs:element name="value" type="xs:string"/></xs:sequence>
    <xs:attribute name="code" type="xs:string"/>
  </xs:complexType>
  <xs:complexType name="Note">
    <xs:simpleContent><xs:extension base="xs:string">
      <xs:attribute name="lang" type="xs:string"/>
    </xs:extension></xs:simpleContent>
  </xs:complexType>
</xs:schema>
